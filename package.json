{
  "name": "moonwave-travel",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:full": "tsc -b && vite build",
    "analyze": "ANALYZE=true vite build",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "typecheck:all": "tsc --noEmit && tsc -p tsconfig.api.json",
    "knip": "knip",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun",
    "size": "size-limit",
    "oxlint": "oxlint src",
    "firebase:emulators": "firebase emulators:start"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "500 kB"
    }
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@headlessui/react": "^2.2.9",
    "@langchain/anthropic": "^1.3.24",
    "@langchain/community": "^1.1.24",
    "@langchain/core": "^1.1.33",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/langgraph": "^1.2.2",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/react": "^10.38.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-virtual": "^3.13.18",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.2.1",
    "exifr": "^7.1.3",
    "firebase": "^12.9.0",
    "framer-motion": "^12.29.0",
    "html2canvas": "^1.4.1",
    "langchain": "^1.2.33",
    "langsmith": "^0.5.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-aria-components": "^1.14.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.12.0",
    "tailwindcss": "^4.1.18",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@size-limit/preset-app": "^12.0.1",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.5.28",
    "@vitejs/plugin-react": "^5.1.1",
    "knip": "^5.87.0",
    "oxlint": "^1.56.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "size-limit": "^12.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
